# The Lab Operation System — environment variables
#
# Copy to .env.local on the VPS and fill in. .env.local is gitignored; .env is
# tracked, so nothing secret belongs in it.
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------
# BUILD TIME vs RUN TIME — the distinction that has already broken production
# once, so it is worth being precise about.
#
# NEXT_PUBLIC_* values are INLINED INTO THE BUNDLE when `npm run build` runs.
# They must be present in the environment AT BUILD TIME. Adding one afterwards
# and restarting the server changes nothing: the old value, or `undefined`, is
# already baked into the JavaScript the browser downloads.
#
# Everything else is read at RUN TIME by the server, so a restart is enough.
#
# A build missing NEXT_PUBLIC_FIREBASE_API_KEY fails at the login screen with
# `auth/api-key-not-valid`, which reads as a wrong key rather than a missing one.
# `scripts/deploy.sh` checks for these before building for exactly that reason.
# ---------------------------------------------------------------------------


# ── Database (run time) ────────────────────────────────────────────────────
# On the VPS the app and PostgreSQL are the same machine, so use localhost —
# not the public IP. That keeps the traffic off the network entirely and means
# port 5432 does not need to be reachable from outside.
DATABASE_URL=postgres://lab_operator:CHANGE_ME@localhost:5432/thelabops

# Set to "true" only if PostgreSQL is remote and behind TLS.
# DATABASE_SSL=false


# ── Employee accounts (run time) ───────────────────────────────────────────
# 32 bytes, base64 or hex:  openssl rand -base64 32
#
# Encrypts stored employee passwords. Without it nobody can sign in with a New
# Operations account and /api/new/auth/login answers 503.
#
# BACK THIS UP somewhere outside the server. If it is lost, every stored
# password becomes undecryptable and every account needs a reset. If it is
# CHANGED, the same thing happens — the old ciphertext will not decrypt.
EMPLOYEE_CREDENTIAL_KEY=


# ── API access (run time) ──────────────────────────────────────────────────
# Shared secret for /api/new/* from outside the browser: Hermes, scripts, curl.
# Requests carrying it are treated as Admin.
#
# If UNSET the gate is open and anyone who can reach the URL can read and write
# every record. Always set it in production.
NEW_OPS_API_KEY=

# Old Operations webhooks. Both have hardcoded fallbacks in the route files, so
# leaving them unset means the endpoint accepts a value that is public in the
# source — set them.
CRM_API_KEY=
CHATBOT_API_KEY=


# ── Firebase (BUILD TIME — rebuild after changing any of these) ────────────
# Old Operations sign-in and Firestore profiles. New Operations does not need
# these; a deployment without them still serves New Operations accounts and
# says so at the login screen instead of failing obscurely.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ── Google Sheets (Old Operations only) ────────────────────────────────────
# BUILD TIME:
NEXT_PUBLIC_DEFAULT_SHEET_URL=
NEXT_PUBLIC_APPS_SCRIPT_URL=

# RUN TIME. The service account is a single line of JSON.
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_SPREADSHEET_ID=
