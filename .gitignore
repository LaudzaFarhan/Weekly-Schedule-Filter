node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# production
build/
dist/

# env files
.env*.local
# Copies of an env file are still an env file. `*.local` does not match
# `.env.local.backup`, and that file holds EMPLOYEE_CREDENTIAL_KEY — losing which
# makes every stored employee password undecryptable, and leaking which makes
# them all readable.
.env*.local.*
*.backup

